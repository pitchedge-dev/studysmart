# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (free plan, no card) — first AI fallback after Gemini.
# Sign up at https://console.groq.com, create a key under API Keys, and
# paste it here. Free plan: openai/gpt-oss-120b + gpt-oss-20b at
# 1,000 requests/day each, plus qwen/qwen3.8-27b for vision. Without it,
# Groq is skipped silently and the app falls back to OpenRouter / Gemini.
GROQ_API_KEY=

# OpenRouter (free :free models, no card) — second AI fallback.
# Sign up at https://openrouter.ai/keys and create a key. Free tier:
# 20 requests/min, 50 requests/day on :free models via the openrouter/free
# router. Without it, OpenRouter is skipped silently. Never commit a real key.
OPENROUTER_API_KEY=

# Supabase (free tier) — create a project named "studysmart" at
# https://supabase.com/dashboard, apply supabase/migrations/*.sql in the SQL
# editor, then paste the project URL and anon key here (never commit real
# values). Without these, accounts / saved guides / Browse / friends are
# disabled with a clear message, and generation still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YouTube Data API (optional) — a free key from the Google Cloud Console
# (enable the YouTube Data API v3) lets /api/videos search YouTube directly.
# Without it, the app asks Gemini for candidate video IDs and verifies every
# one with YouTube's oEmbed endpoint before showing it; if nothing verifies,
# the guide shows YouTube search links instead. Never commit a real key.
YOUTUBE_API_KEY=
